# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER commit this or expose to client)
# Place ONLY in .env.local for running admin seed scripts and server-side privileged tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js App URL (for redirects & callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

